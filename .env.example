# Modèle de configuration de ComplianceCopilot.
# Copier ce fichier en .env puis remplacer les valeurs. Le fichier .env n'est jamais versionné.

# --- PostgreSQL (lu par compose.yaml) ---
# Utilisateur créé au premier démarrage de la base
POSTGRES_USER=compliance
# Mot de passe de cet utilisateur (à remplacer par une valeur aléatoire)
POSTGRES_PASSWORD=change-me
# Nom de la base créée au premier démarrage
POSTGRES_DB=compliance_copilot
# Port exposé sur la machine hôte (uniquement en local, 127.0.0.1)
POSTGRES_PORT=5432

# --- Backend FastAPI (facultatif : valeurs par défaut ci-dessous) ---
# Hôte PostgreSQL vu par le backend (localhost quand le backend tourne sur le Mac)
# POSTGRES_HOST=localhost
# Adresse d'Ollama (depuis un conteneur : http://host.docker.internal:11434)
# OLLAMA_BASE_URL=http://localhost:11434
